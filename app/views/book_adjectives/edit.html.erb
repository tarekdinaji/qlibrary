<%= form_with url: book_adjectives_path, method: :patch do |form| %>
  <div class="form-group">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>
    <% if @type == "SubCategory" %>
      <div class="form-group">
      <%= form.label :category_id %>
      <%= form.collection_select :category_id, @categories, :id,lambda { |c| c.title.titleize }, prompt: "Select a main Category"  %>
      </div>
    <% end %>

  <div class="actions">
    <%= form.submit "Update Post" %>
  </div>
<% end %>
