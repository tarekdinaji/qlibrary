<h2 class= "text-center">Book Adjectives</h2>
<br>
<div class="container">
  <div class="row">
    <div class="col-4">
      <div class="category">
        <h4>Main Categories</h4>
        <ul class="p-0">
          <% @categories.each do |category| %>
            <li class="hover-item d-flex justify-content-between align-items-center">
              <%= category.title.capitalize %>
              <%= link_to "Update", edit_book_adjective_path(category, type: "Category"), class: "btn btn-primary btn-sm hover-button" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <div class="col-4">
      <div class="sub_category">
        <h4>Sub-Categories</h4>
        <ul class="p-0">
          <% @sub_categories.each do |sub_category| %>
            <li class="hover-item d-flex justify-content-between align-items-center">
              <%= sub_category.title.capitalize %>
              <%= link_to "Update", edit_book_adjective_path(sub_category, type: "SubCategory"), class: "btn btn-primary btn-sm hover-button" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <div class="col-4">
      <div class="genre">
        <h4>All Genres</h4>
        <ul class="p-0">
          <% @genres.each do |genre| %>
            <li class="hover-item d-flex justify-content-between align-items-center">
              <%= genre.title.capitalize %>
              <%= link_to "Update", edit_book_adjective_path(genre, type: "Genre"), class: "btn btn-primary btn-sm hover-button" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
