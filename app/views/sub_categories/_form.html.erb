<%= form_with model: @sub_category do |form| %>
  <% if @sub_category.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@sub_category.errors.count, "error") %> prevented this SubCategory from being saved:</h4>
      <ul>
        <% @sub_category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= form.label :title, "Title" %><br>
    <%= form.text_field :title %>
  </p>
   <p>
    <%= form.label :category_id, "Main Category" %><br>
    <%# <%= form.select_option (:category_id, @categories, :id, :name, prompt: "Select a category") %>
    <%= form.select :category_id, @categories.map { |c| [c.title, c.id] } %>
  </p>

  <%= form.submit "Save" %>
<% end %>
