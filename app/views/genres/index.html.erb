<h1>Genres</h1>

<%= link_to "New Genre", new_genre_path %>

<ul>
  <% @genres.each do |genre| %>
    <li>
      <%= genre.title %> |
      <%= link_to "Show", genre_path(genre) %> |
      <%= link_to "Edit", edit_genre_path(genre) %> |
      <%= button_to "Delete", genre, method: :delete, data: { confirm: "Are you sure?" } %>
    </li>
  <% end %>
</ul>
